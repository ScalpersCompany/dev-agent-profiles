{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dev-agent-kit flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "api", "kind", "description", "base_profile", "entrypoint", "roles", "stages", "agents"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "api": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "flow"},
    "description": {"type": "string", "minLength": 1},
    "base_profile": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "string", "minLength": 1},
    "roles": {"type": "string", "minLength": 1},
    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "agents": {"type": "string", "minLength": 1}
  }
}
