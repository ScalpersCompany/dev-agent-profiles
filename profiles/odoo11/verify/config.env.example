# Copy to verify/config.env and fill with the real commands.
# Boot the app or the test database. Leave empty if the environment is already up.
BOOT_CMD=""
# URL that answers 200 when the app is ready. Leave empty to skip the probe.
HEALTH_URL=""
# Command that exercises the feature as a user would. Exit 0 means pass.
SMOKE_CMD=""
# Unit or integration tests for the change. Exit 0 means pass.
TEST_CMD=""
# Complete browser E2E suite for website, portal, SGA or back-office flows.
# Playwright example: npm --prefix e2e test
E2E_CMD=""
# Disposable environment URL; never production.
E2E_BASE_URL=""
# Path used by the baseline health spec.
E2E_HEALTH_PATH="/"
# Seconds to wait for HEALTH_URL.
HEALTH_TIMEOUT="60"
