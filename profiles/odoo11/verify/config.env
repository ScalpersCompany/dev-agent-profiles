# Real test for the development base. The database is disposable and unique per run.
BOOT_CMD=""
HEALTH_URL=""
SMOKE_CMD=""
TEST_CMD='set -e; cd /home/scalpers/odoo-doodba-template; DB="test_devkit_verify_$(date +%Y%m%d_%H%M%S)"; docker compose -f devel.yaml run --rm --entrypoint odoo odoo --config=/opt/odoo/auto/odoo.conf -d "$DB" -i scalpers_partner_vat_unique --stop-after-init --workers=0 --log-level=info; docker compose -f devel.yaml run --rm --entrypoint odoo odoo --config=/opt/odoo/auto/odoo.conf -d "$DB" -u scalpers_partner_vat_unique --test-enable --stop-after-init --workers=0 --log-level=test'
HEALTH_TIMEOUT="60"
