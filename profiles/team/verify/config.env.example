# Copy to verify/config.env. The team profile inherits the base profile commands instead of
# duplicating them; set TEAM_BASE_VERIFY to that profile's config.
TEAM_BASE_VERIFY="${TEAM_BASE_VERIFY:-.dev-agent/profiles/odoo11/verify/config.env}"
if [ -f "$TEAM_BASE_VERIFY" ]; then
  . "$TEAM_BASE_VERIFY"
fi
BOOT_CMD="${BOOT_CMD:-}"
HEALTH_URL="${HEALTH_URL:-}"
SMOKE_CMD="${SMOKE_CMD:-}"
TEST_CMD="${TEST_CMD:-}"
E2E_CMD="${E2E_CMD:-}"
E2E_BASE_URL="${E2E_BASE_URL:-}"
E2E_HEALTH_PATH="${E2E_HEALTH_PATH:-/}"
HEALTH_TIMEOUT="${HEALTH_TIMEOUT:-60}"
